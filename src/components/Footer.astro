---
import { site } from "../lib/site";
import Brand from "./Brand.astro";
---

<footer class="border-t border-line py-10">
  <div class="wrap flex flex-col justify-between gap-7 sm:flex-row">
    <div>
      <Brand />
      <p class="mt-3 text-sm text-muted">By {site.owner}.</p>
    </div>
    <nav
      aria-label="Footer"
      class="flex flex-wrap content-start gap-x-6 gap-y-3 text-sm"
    >
      <a href="/docs/" class="hover:underline">
        Guides
      </a>
      <a href={site.appRepository} class="hover:underline">
        GitHub
      </a>
      <a href="/about/#support" class="hover:underline">
        Support
      </a>
      <a href="/privacy/" class="hover:underline">
        Privacy
      </a>
    </nav>
  </div>
</footer>
