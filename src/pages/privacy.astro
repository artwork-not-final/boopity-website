---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Website privacy"
  description="Privacy on the Boopity website."
>
  <article class="wrap max-w-3xl py-16">
    <h1 class="display text-5xl">Website privacy</h1>
    <p class="mt-8 leading-relaxed">
      This site has no accounts, analytics, or advertising trackers. Guide
      search runs in your browser, which also stores your theme preference.
    </p>
    <p class="mt-5 leading-relaxed">
      The host may log requests, including IP addresses. External sites such as
      GitHub have their own privacy policies.
    </p>
    <h2 class="mt-10 text-2xl font-semibold">Client records</h2>
    <p class="mt-4 leading-relaxed">
      For questions about bookings, payments, or personal information, contact
      the pet-care business running your Boopity installation.
    </p>
  </article>
</MarketingLayout>
