---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { Image } from "astro:assets";
import bookings from "../assets/screenshots/bookings.png";
import services from "../assets/screenshots/services.png";
import clients from "../assets/screenshots/clients.png";
const sections = [
  {
    title: "Start with your services.",
    text: "Set the price and duration for a walk, a visit, or a stay. Decide which services clients can book through their portal.",
    image: services,
    alt: "Services and rates for the fictional Maple & Paws business, including dog walking and drop-in visits.",
  },
  {
    title: "Keep the important details together.",
    text: "Add a client and their pets. Keep contact details, care instructions, and your private notes in one place.",
    image: clients,
    alt: "The Clients and pets page with fictional clients Alex Example, Casey Harper, and Taylor Brooks.",
  },
  {
    title: "Know what’s on the calendar.",
    text: "Switch between week, month, and list views. Open a booking to see its details, recorded payments, and history.",
    image: bookings,
    alt: "The weekly booking calendar displaying three example pet-care bookings.",
  },
];
---

<MarketingLayout
  title="A look around Boopity"
  description="See how Boopity brings services, clients, pets, bookings, and payments together."
>
  <div class="wrap py-14 sm:py-20">
    <p class="eyebrow mb-4 text-forest">The product tour</p>
    <h1 class="display max-w-2xl text-5xl sm:text-6xl">
      From the first hello
      <br />
      to the next visit.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted">
      A few familiar tasks, with everything where you need it. These are real
      screens from Boopity 1.0.1, using fictional data.
    </p>
  </div>
  {sections.map((section, i) => (
    <section class="wrap mb-16 grid items-start gap-8 lg:grid-cols-[.65fr_1.35fr]">
      <div>
        <p class="eyebrow mb-4 text-muted">0{i + 1}</p>
        <h2 class="display text-4xl">{section.title}</h2>
        <p class="mt-5 leading-relaxed text-muted">{section.text}</p>
      </div>
      <Image
        src={section.image}
        alt={section.alt}
        widths={[640, 960, 1440]}
        sizes="(max-width: 1024px) 100vw, 800px"
        class="w-full rounded-xl border border-line shadow-sm"
      />
    </section>
  ))}
  <section class="wrap mb-20 border-t border-line pt-10">
    <h2 class="text-2xl font-semibold">Ready to try your first booking?</h2>
    <p class="mt-3 mb-6 text-muted">
      Our guide takes you from adding a service to recording a payment.
    </p>
    <a
      href="/docs/getting-started/first-booking/"
      class="button button-primary"
    >
      Follow the walkthrough <span aria-hidden="true">→</span>
    </a>
  </section>
</MarketingLayout>
