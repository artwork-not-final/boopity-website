---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { site } from "../lib/site";
---

<MarketingLayout
  title="About Boopity"
  description="Free, open-source pet-sitting software by Artwork Not Final LLC."
>
  <article class="wrap max-w-3xl py-16 sm:py-24">
    <p class="eyebrow mb-5 text-forest">About Boopity</p>
    <h1 class="display text-5xl sm:text-6xl">
      Open source.
      <br />
      Yours to run.
    </h1>
    <p class="mt-8 text-xl leading-relaxed">
      Boopity is free, open-source software for independent pet sitters, made by{" "}
      {site.owner}.
    </p>
    <p class="mt-4 leading-relaxed text-muted">
      Use it, adapt it, or help improve it. The code is available under the MIT
      license.
    </p>
    <a class="text-link mt-5 inline-block" href={site.appRepository}>
      View on GitHub
    </a>
    <h2 id="support" class="mt-12 text-2xl font-semibold">
      Need help?
    </h2>
    <p class="mt-4 leading-relaxed text-muted">
      Support is community-led, with no guaranteed response time.
    </p>
    <p class="mt-4 leading-relaxed text-muted">
      Start with the{" "}
      <a class="text-link" href="/docs/help/troubleshooting/">
        troubleshooting guide
      </a>
      . For security concerns, follow the{" "}
      <a
        class="text-link"
        href="https://github.com/artwork-not-final/boopity/blob/main/SECURITY.md"
      >
        security policy
      </a>{" "}
      to report them privately.
    </p>
  </article>
</MarketingLayout>
