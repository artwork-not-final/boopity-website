{
  "name": "boopity-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 4326",
    "deploy": "npm run verify && wrangler deploy",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:deploy": "wrangler deploy --dry-run",
    "verify": "npm run check && npm run format:check && npm test && npm run build && npm run check:site && npm run check:deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "parse5": "8.0.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
